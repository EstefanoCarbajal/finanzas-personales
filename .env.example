# Configuración privada. Copiar a .env.local; nunca subir ese archivo.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
APP_TIMEZONE=America/Lima
DB_SSL=true
# Solo al ejecutar pruebas de integración en una base de pruebas autorizada.
TEST_DB_NAME=
# Solo para npm run db:create-user; retirar después de crear la cuenta.
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=

